# ── FastAPI ──────────────────────────────────────────────
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ── Supabase (Dashboard → Project Settings → API) ────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# ── Auth ─────────────────────────────────────────────────
# true  → skip JWT verification, run every request as DEV_USER_ID
# false → require a real Supabase (Google) login
DEV_BYPASS_AUTH=false
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# ── LLMs ─────────────────────────────────────────────────
# Groq powers resume parsing, gap analysis, roadmap/deep research, and the judge.
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama-3.3-70b-versatile
# Gemini is used only for embeddings (Pinecone semantic retrieval). Support rotation with _1, _2, etc.
GOOGLE_API_KEY=YOUR_GEMINI_API_KEY_HERE
GOOGLE_API_KEY_1=
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=
GOOGLE_API_KEY_4=

# ── Self-hosted LLM (optional) ───────────────────────────
# Run ALL generation on your own machine instead of Groq/Gemini — any
# OpenAI-compatible server works (llama.cpp `llama-server`, Ollama, vLLM, …).
# When true, both the Groq path and the Gemini path route here. Embeddings are
# separate (see the Qdrant/embed sidecar section). Use ONE model to avoid
# llama-swap cold-boot thrash between agents.
USE_SELF_HOSTED_LLM=false
SELF_HOSTED_LLM_BASE_URL=http://localhost:8080/v1
SELF_HOSTED_LLM_MODEL=local-model
# llama.cpp ignores the key; leave the placeholder unless your server needs one.
SELF_HOSTED_LLM_API_KEY=sk-no-key-required

# ── Web search ───────────────────────────────────────────
TAVILY_API_KEY=YOUR_TAVILY_API_KEY_HERE

# ── Gap analysis: Qdrant vector DB + local embed/rerank sidecar ──
# Vector DB. `docker compose up` starts Qdrant locally on :6333.
# For prod, point at Qdrant Cloud (free tier) and set QDRANT_API_KEY.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=careeratlas_taxonomy

# Embeddings + reranker — bring your own. Any OpenAI-compatible server works.
# Defaults target the bundled sidecar (backend/embed-rerank), which serves
# Nemotron-3-Embed (2048-dim) and Jina-reranker-v3. Change EMBEDDINGS_DIM only
# alongside a re-ingest (`uv run python scripts/ingest_taxonomy.py --wipe`).
EMBEDDINGS_BASE_URL=http://localhost:7997
EMBEDDINGS_MODEL=nemotron-embed
EMBEDDINGS_DIM=2048
RERANKER_BASE_URL=http://localhost:7997
RERANKER_MODEL=jina-reranker-v3

# ── Job search: Adzuna ───────────────────────────────────
ADZUNA_APP_ID=YOUR_ADZUNA_APP_ID
ADZUNA_APP_KEY=YOUR_ADZUNA_APP_KEY

# ── Monitoring ───────────────────────────────────────────
# Sentry error tracking — leave blank to disable.
SENTRY_DSN=
# LangSmith LLM/agent tracing.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=YOUR_LANGSMITH_API_KEY
LANGSMITH_PROJECT=careeratlas-prod

# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
